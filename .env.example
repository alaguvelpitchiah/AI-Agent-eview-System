# ==============================================================================
# AI Agent Review and Performance Improvement System - Configuration
# ==============================================================================

# Server ports
PORT=8004
STREAMLIT_PORT=8501
DEV_FRONTEND_PORT=5173

# Security & SSRF Protection
# Set ALLOW_LOCAL_TESTING=1 only during local development/sandbox tests
ALLOW_LOCAL_TESTING=1

# External Target AI Agent Credentials (auto-masked in logs)
AGENT_API_KEY=your-external-agent-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution constraints
EXECUTION_TIMEOUT_SECONDS=30.0
MAX_TASK_BYTES=100000
TEST_BUDGET=16

# Database Paths
DATABASE_URL=sqlite:///./review.db
APP_DB_PATH=./app.db
